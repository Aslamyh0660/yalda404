# Environment for the Sharea verification page.
#
# Nothing here is required to build or run the page. Copy to .env.local for
# local work. Never put a secret in a VITE_* variable: those ship to the
# browser. All credentials stay on the server (see workers/likes/).

# Public URL of the like backend (a Cloudflare Worker — see README).
# Leave empty and the page shows an honest "counter unavailable" state.
# VITE_LIKES_API_BASE=https://sharea-likes.your-subdomain.workers.dev

# Base path the site is served from. Leave empty for a domain root
# (Cloudflare Pages, Netlify, Vercel). The GitHub Pages workflow sets
# /<repository-name>/ automatically.
# BASE_PATH=/
