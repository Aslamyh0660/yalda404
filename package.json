{
  "name": "sharea-verify",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sharea | شارع — universal verified-location landing page. Material 3 Expressive via shadcn M3E.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
    "typecheck:worker": "tsc -p workers/likes/tsconfig.json --noEmit",
    "check": "npm run check:icons && npm run typecheck && npm run typecheck:worker && npm run build && npm run check:markup",
    "check:markup": "node scripts/check-markup.mjs",
    "check:arabic": "node scripts/render-copy-sheet.mjs",
    "check:icons": "node scripts/icons.mjs --check",
    "gen:icons": "node scripts/icons.mjs",
    "colors:report": "tsx scripts/color-report.ts",
    "fonts": "node scripts/fonts.mjs",
    "assets": "node scripts/fonts.mjs && node scripts/make-assets.mjs && node scripts/generate-qr.mjs",
    "qr": "node scripts/generate-qr.mjs",
    "verify:qr": "node scripts/verify-qr.mjs",
    "likes:dev": "wrangler dev --config workers/likes/wrangler.toml",
    "likes:migrate": "wrangler d1 migrations apply sharea_likes --config workers/likes/wrangler.toml",
    "likes:deploy": "wrangler deploy --config workers/likes/wrangler.toml",
    "test:likes": "node workers/likes/test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "@iconify/react": "^6.0.2",
    "@material/material-color-utilities": "^0.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@iconify-json/material-symbols": "^1.2.95",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "wrangler": "^4.149.0"
  }
}
